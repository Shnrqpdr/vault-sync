# Copy to .env and fill in. deploy/bootstrap.sh generates one with random secrets.
# CouchDB users, passwords and database names: letters, digits and . _ ~ - only.

# Public domain for both Obsidian sync and the MCP server.
VAULT_DOMAIN=vault.example.com

# CouchDB admin. Stays on the server; only the first device's LiveSync setup
# uses it, once (see the README).
COUCH_USER=admin
COUCH_PASSWORD=change-me-to-a-long-random-password
# Sync user: owns the vault database. Obsidian and vault-core log in with it.
COUCH_SYNC_USER=obsidian
COUCH_SYNC_PASSWORD=change-me-to-another-long-random-password
COUCH_DB=obsidian
# Seconds between couchdb-guard checks that keep the database restricted to the
# sync user (a device's "Rebuild everything" recreates it admin-only).
# COUCH_GUARD_INTERVAL=30

RUST_LOG=vault_core=info

# Git snapshots of the mirror, every N seconds; 0 disables them.
BACKUP_INTERVAL_SECS=600
# Private repository that receives the history (NOT the vault-sync repo).
# Empty = history kept only on the server.
#   SSH, with the deploy key at secrets/backup_deploy_key:
#     git@github.com:<you>/<notes-repo>.git
#   HTTPS with a fine-grained token (Contents: read and write):
#     https://x-access-token:<token>@github.com/<you>/<notes-repo>.git
BACKUP_REMOTE=
BACKUP_BRANCH=main

# MCP server at https://<VAULT_DOMAIN>/mcp. Both empty = disabled.
# Generate with: openssl rand -hex 32
# Static bearer token, for MCP clients that can set an Authorization header.
MCP_TOKEN=
# Password for the OAuth authorization page, for MCP clients that sign in with OAuth.
MCP_PASSWORD=
# Only if the MCP server lives on a different domain than VAULT_DOMAIN.
# MCP_PUBLIC_URL=https://mcp.example.com
# Lets MCP clients create and edit notes (not delete them). Off by default.
MCP_WRITE=false
# Vault folder with one <name>/SKILL.md per skill; each becomes an MCP prompt.
# MCP_SKILLS_DIR=skills
# Skills the model must read and follow before writing, e.g. vault-keeper,humanizer
MCP_WRITE_SKILLS=

# --- Reverse proxy: pick one (see README) ---
# Bundled Caddy (`docker compose --profile proxy up`): e-mail for Let's Encrypt.
ACME_EMAIL=you@example.com
# Existing Traefik (docker-compose.traefik.yml): its Docker network,
# HTTPS entrypoint and certificate resolver.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
